# Clinical Summarizer Environment Variables
# Copy this file to .env and populate with your actual values
# .env is in .gitignore and should NEVER be committed
#
# ⚠️  SECURITY WARNING ⚠️
# This file contains sensitive information:
# - AWS Access Keys
# - API Keys
# Never share or commit .env to version control
# Never commit credentials to any branch

# ============================================================================
# CHOOSE ONE: AWS API GATEWAY or ANTHROPIC API
# ============================================================================

# Option 1: AWS API Gateway (Production - calls Lambda → Bedrock)
# Get this from: cd terraform && terraform output api_url
API_GATEWAY_URL=https://abc123.execute-api.us-east-1.amazonaws.com/prod/summarize

# Option 2: Anthropic API (Local/Dev - for testing without AWS)
# Get this from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ============================================================================
# AWS Configuration (only needed if using API_GATEWAY_URL)
# ============================================================================

# AWS Region for Terraform state and resources
AWS_REGION=us-east-1

# AWS IAM Credentials (for deploying via Terraform)
# Get these from: AWS Console → IAM → Users → Your User → Security Credentials
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=wJal...

# AWS Profile for AWS CLI (optional - uses default if not set)
# AWS_PROFILE=default

# ============================================================================
# Local Development
# ============================================================================

# Flask/FastAPI environment
ENVIRONMENT=development

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# Optional: Database Configuration
# ============================================================================

# SQLite database file path (default: clinical.db in project root)
# DATABASE_URL=sqlite:///clinical.db

# ============================================================================
# How to Get Your Credentials
# ============================================================================
#
# ANTHROPIC_API_KEY:
#   1. Go to https://console.anthropic.com/
#   2. Click "API Keys" in the left sidebar
#   3. Create or copy your API key
#   4. Format: sk-ant-...
#
# AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY:
#   1. Go to AWS Console → IAM → Users
#   2. Select your user or create a new one
#   3. Go to "Security Credentials" tab
#   4. Create "Access Key" (or use existing one)
#   5. Copy the Access Key ID and Secret Access Key
#   6. Format: AKIA... and wJal...
#
# API_GATEWAY_URL:
#   1. Deploy the infrastructure: cd terraform && terraform apply
#   2. Get the URL: terraform output api_url
#
# ============================================================================
# Notes
# ============================================================================
# - API_GATEWAY_URL takes priority if both API_GATEWAY_URL and ANTHROPIC_API_KEY are set
# - Never commit .env file to version control
# - Use .env.example as a template for team members
# - Rotate AWS keys periodically for security
# - Delete/revoke keys if you accidentally commit them
